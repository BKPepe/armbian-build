# DO NOT EDIT THIS FILE
#
# Please edit /boot/armbianEnv.txt to set supported parameters
#

# The U-Boot in the SPI NOR flash starts this script with distro boot. This
# U-Boot is the stock U-Boot of Turris OS or the U-Boot that Armbian builds.
# The script uses the load addresses of this U-Boot. It does not set MAC
# addresses. In bootz, U-Boot writes its MAC addresses to the device tree.

# armbianEnv.txt goes to the default load address of U-Boot, below kernel_addr_r.
setenv load_addr "0x800000"
setenv verbosity "1"
setenv rootdev
setenv rootfstype "ext4"
setenv l_rootflags

# Distro boot found this script in ${prefix}, which is / or /boot/. The Turris
# rescue system (reset with 4 LEDs) installs a medkit to the btrfs subvolume @.
# The rescue system links /boot.scr to @/boot/boot.scr.
setenv l_bootdir "${prefix}"
if test -e ${devtype} ${devnum}:${distro_bootpart} /@/boot/zImage; then
	setenv l_bootdir "/@/boot/"
	setenv rootfstype "btrfs"
fi

if test -e ${devtype} ${devnum}:${distro_bootpart} ${l_bootdir}armbianEnv.txt; then
	load ${devtype} ${devnum}:${distro_bootpart} ${load_addr} ${l_bootdir}armbianEnv.txt
	env import -t ${load_addr} ${filesize}
fi

# armbianEnv.txt can set rootdev and rootfstype. Without rootdev, the root is
# this partition.
setenv l_partuuid
part uuid ${devtype} ${devnum}:${distro_bootpart} l_partuuid
if test -z "${rootdev}"; then setenv rootdev "PARTUUID=${l_partuuid}"; fi

# Mount the subvolume @ only if the root is the medkit partition. armbian-install
# can move the root to another disk.
if test "${l_bootdir}" = "/@/boot/"; then
	setenv l_fsuuid
	fsuuid ${devtype} ${devnum}:${distro_bootpart} l_fsuuid
	if test "${rootdev}" = "PARTUUID=${l_partuuid}" -o "${rootdev}" = "UUID=${l_fsuuid}"; then
		setenv l_rootflags "rootflags=subvol=@"
	fi
fi

setenv bootargs "console=ttyS0,115200 root=${rootdev} rootwait rootfstype=${rootfstype} ${l_rootflags} rw loglevel=${verbosity} usb-storage.quirks=${usbstoragequirks} ${extraboardargs} ${extraargs}"

# The kernel needs the initramfs to load the btrfs module and to find root=UUID=.
# If a file is missing, the script stops and distro boot continues its scan.
echo "Booting ${l_bootdir}zImage with root=${rootdev} ${l_rootflags}"
load ${devtype} ${devnum}:${distro_bootpart} ${kernel_addr_r} ${l_bootdir}zImage || exit
load ${devtype} ${devnum}:${distro_bootpart} ${fdt_addr_r} ${l_bootdir}dtb/${fdtfile} || exit
load ${devtype} ${devnum}:${distro_bootpart} ${ramdisk_addr_r} ${l_bootdir}uInitrd || exit

# A module in the SFP cage makes a multiplexer connect the WAN port to the cage.
# The Linux device tree then needs three changes, which U-Boot does not make.
# A module pulls MOD-DEF0 (gpio@71_4) low. "gpio input" returns the pin value,
# and 0 makes the test true. Reboot after you insert or remove an SFP module.
if gpio input gpio@71_4; then
	echo "SFP module found, using the SFP cage for the WAN port"
	fdt addr ${fdt_addr_r}
	fdt resize 0x1000
	fdt set /sfp status "okay"
	fdt rm /soc/internal-regs/ethernet@34000 phy-handle
	fdt set /soc/internal-regs/ethernet@34000 managed "in-band-status"
fi

bootz ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}

# Recompile with:
# mkimage -C none -A arm -T script -d /boot/boot.cmd /boot/boot.scr
